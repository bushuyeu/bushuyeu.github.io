---
layout: page.njk
title: Writing
permalink: /writing/
intro: Notes on research, evaluation, and building with models.
---
{%- if collections.writing | length %}
<div class="feed">
  {%- for post in collections.writing %}
  <article class="feed__item">
    <div class="feed__date"><time datetime="{{ post.date | isoDate }}">{{ post.date | monthYear }}</time></div>
    <div>
      <h3 class="feed__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {%- if post.data.intro %}<p class="feed__body">{{ post.data.intro }}</p>{% endif %}
    </div>
  </article>
  {%- endfor %}
</div>
{%- else %}
<p class="muted">Nothing published yet.</p>
{%- endif %}
