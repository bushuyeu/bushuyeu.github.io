<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:type" content="website">
<meta property="og:title" content="{% if title and page.url != '/' %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Source+Sans+3:wght@400;600&display=swap">
<link rel="stylesheet" href="/assets/style.css">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <div class="site-header__inner">
      <a class="wordmark" href="/">{{ site.name }}</a>
      <nav class="site-nav" aria-label="Main">
        {%- for item in site.nav %}
        <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
        {%- if collections.writing | length %}
        <a href="/writing/"{% if "/writing/" in page.url %} aria-current="page"{% endif %}>Writing</a>
        {%- endif %}
      </nav>
    </div>
  </div>
</header>

<main id="main">
  <div class="wrap">
    {{ content | safe }}
  </div>
</main>

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <span>{{ site.name }} · {{ site.location }}</span>
    <ul>
      {%- for link in site.links %}
      <li><a href="{{ link.href }}">{{ link.label }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</footer>
</body>
</html>
