---
layout: base.njk
---
<article>
  <div class="page-intro">
    <p class="eyebrow"><time datetime="{{ date | isoDate }}">{{ date | fullDate }}</time></p>
    <h1>{{ title }}</h1>
    {%- if intro %}<p class="lead muted">{{ intro }}</p>{% endif %}
  </div>
  {{ content | safe }}
</article>
